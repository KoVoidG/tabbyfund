# =============================================================================
# TabbyFund Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local with real secrets.
# =============================================================================

# Supabase — Get from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role — SERVER-ONLY, bypasses RLS
# ⚠️  NEVER prefix with NEXT_PUBLIC_ or expose in client components
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — SERVER-ONLY, for AI cat condition analysis
# Get from: https://ai.google.dev/
GEMINI_API_KEY=

# Geoapify Geocoding — SERVER-ONLY, for vet clinic location lookup
# Get from: https://www.geoapify.com/
GEOAPIFY_API_KEY=

# Site URL — used for password reset email links
# Set to http://localhost:3000 for local dev, your domain for production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# E2E Test Credentials (only needed for running Playwright tests)
# =============================================================================
E2E_COMMUNITY_EMAIL=somchai@example.com
E2E_COMMUNITY_PASSWORD=password123
E2E_ADMIN_EMAIL=admin@tabbyfund.com
E2E_ADMIN_PASSWORD=password123
E2E_VET_EMAIL=dr.siriporn@example.com
E2E_VET_PASSWORD=password123
