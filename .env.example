# =============================================================================
# TabbyFund Environment Variables

# Copy this file to .env.local before running locally.
# Free, project-scoped demo keys for Gemini and Geoapify are included for judging.
# Supabase keys are intentionally not included.
# NEVER commit Supabase service role keys, database passwords, or personal secrets.
# =============================================================================

# Supabase — Get from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role — SERVER-ONLY, bypasses RLS
# ⚠️ Do NOT commit this value publicly.
# For public judging, this should remain blank unless shared privately.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — SERVER-ONLY, free project-scoped demo key for judging
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Geoapify — SERVER-ONLY, free project-scoped demo key for judging
# Get from: https://www.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Site URL — used for password reset email links
# Set to http://localhost:3000 for local dev, your domain for production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# E2E Test Credentials (only needed for running Playwright tests)
# =============================================================================
E2E_COMMUNITY_EMAIL=somchai@example.com
E2E_COMMUNITY_PASSWORD=password123
E2E_ADMIN_EMAIL=admin@tabbyfund.com
E2E_ADMIN_PASSWORD=password123
E2E_VET_EMAIL=dr.siriporn@example.com
E2E_VET_PASSWORD=password123
